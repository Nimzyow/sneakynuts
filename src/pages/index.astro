<style>
  .sidebar-nav {
    position: fixed;
    left: 2rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    z-index: 100;
  }

  .sidebar-item {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #555555;
    cursor: pointer;
    transition: color 200ms ease;
  }

  .sidebar-item:hover {
    color: #a1a1aa;
  }

  .sidebar-item.active {
    color: #ffffff;
  }

  .project-section {
    opacity: 1;
    transition: opacity 300ms ease;
  }

  .project-content--fade {
    animation: fadeIn 500ms ease forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .snap-section {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .main-section {
    min-height: 100vh;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #ffffff;
  }

  .anomaly-text {
    position: relative;
    cursor: pointer;
    color: #ffffff;
    letter-spacing: 2px;
  }

  .anomaly-text:hover {
    animation: glitch-bw 3s infinite;
  }

  @keyframes glitch-bw {
    0% { text-shadow: 1.5px 0px 0px rgba(255,255,255,0.6), -1.5px 0px 0px rgba(200,200,200,0.4); transform: translate(0); }
    20% { text-shadow: -2.5px 0px 0px rgba(255,255,255,0.5), 2.5px 0px 0px rgba(150,150,150,0.5); transform: translate(1.5px, -1px); }
    40% { text-shadow: 2.5px 0px 1px rgba(180,180,180,0.5), -2.5px 0px 1px rgba(255,255,255,0.4); transform: translate(-1.5px, 1px); }
    60% { text-shadow: 2px 0.5px 0px rgba(200,200,200,0.45), -2px -0.5px 0px rgba(255,255,255,0.5); transform: translate(1px, -0.5px); }
    100% { text-shadow: 1.5px 0px 0px rgba(255,255,255,0.6), -1.5px 0px 0px rgba(200,200,200,0.4); transform: translate(0); }
  }

  .logo-strip {
    margin-top: 1.5rem;
    width: 100%;
    max-width: 600px;
    overflow: hidden;
  }

  .logo-track {
    display: inline-flex;
    gap: 3rem;
    justify-content: center;
    font-size: 0.9rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    animation: logo-marquee 10s linear infinite;
  }

  .logo-link {
    opacity: 0.25;
    transition:
      color 200ms ease,
      text-shadow 200ms ease,
      opacity 200ms ease,
      transform 200ms ease;
    cursor: pointer;
  }

  .logo-link:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .logo-link.glow-purple:hover {
    color: #a855f7;
    text-shadow: 0 0 18px rgba(168, 85, 247, 0.9);
  }

  h2.glow-purple {
    color: #a855f7;
    text-shadow: 0 0 18px rgba(168, 85, 247, 0.9);
  }

  h2.glow-green {
    color: #22c55e;
    text-shadow: 0 0 18px rgba(34, 197, 94, 0.9);
  }

  h2.glow-blue {
    color: rgb(34, 69, 197);
    text-shadow: 0 0 18px rgba(34, 80, 197, 0.9);
  }

  h2.glow-red {
    color: rgb(197, 34, 45);
    text-shadow: 0 0 18px rgba(197, 34, 53, 0.9);
  }

  h2.glow-orange {
    color: rgb(233, 131, 23);
    text-shadow: 0 0 18px rgba(197, 86, 34, 0.9);
  }

  .logo-link.glow-green:hover {
    color: #22c55e;
    text-shadow: 0 0 18px rgba(34, 197, 94, 0.9);
  }

  .logo-link.glow-blue:hover {
    color:rgb(34, 69, 197);
    text-shadow: 0 0 18px rgba(34, 80, 197, 0.9);
  }

  .logo-link.glow-red:hover {
    color:rgb(197, 34, 45);
    text-shadow: 0 0 18px rgba(197, 34, 53, 0.9);
  }

    .logo-link.glow-orange:hover {
    color:rgb(233, 131, 23);
    text-shadow: 0 0 18px rgba(197, 86, 34, 0.9);
  }

  .logo-strip:hover .logo-track {
    animation-play-state: paused;
  }

  .begin-button {
    margin-top: 1.5rem;
    padding: 0.75rem 2rem;
    background-color: transparent;
    border: 1px solid #555555;
    color: #a1a1aa;
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .begin-button:hover {
    color: #ffffff;
    border-color: #ffffff;
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.2);
  }

  .begin-button.hidden {
    display: none;
  }

  @keyframes logo-marquee {
    0% {
      transform: translateX(100%);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  .logo-detail {
    margin-top: 2.5rem;
    width: fit-content;
    padding: 0 1.5rem;
    margin-left: auto;
    margin-right: auto;
    max-height: 0;
    opacity: 0;
    overflow: visible;
    transform: translateY(8px);
    border-top: 1px solid #27272a;
    animation: pulse-border 3s ease-in-out infinite;
    transition:
      max-height 300ms ease,
      opacity 250ms ease,
      transform 250ms ease;
    min-width: 200px;
  }

  @keyframes pulse-border {
    0% {
      border-color: #27272a;
    }
    50% {
      border-color: #555555;
    }
    100% {
      border-color: #27272a;
    }
  }

  .logo-detail--open {
    max-height: 400px;
    opacity: 1;
    transform: translateY(0);
  }

  .logo-detail__title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 1.5rem 0 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
  }

  .logo-detail__body {
    font-size: 0.9rem;
    color: #a1a1aa;
    margin-bottom: 1.75rem;
    line-height: 1.7;
  }
</style>

<script>
  if (typeof window !== "undefined") {
    window.addEventListener("DOMContentLoaded", () => {
      const beginBtn = document.getElementById("begin-btn");
      const sidebarItems = document.querySelectorAll(".sidebar-item");

      if (beginBtn) {
        beginBtn.addEventListener("click", () => {
          beginBtn.classList.add("hidden");
          // Scroll to first project section
          const firstProject = document.querySelector('[data-section="1"]');
          if (firstProject) {
            firstProject.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        });
      }

      // Update sidebar on scroll
      const sections = document.querySelectorAll(".snap-section");
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const sectionNum = entry.target.getAttribute("data-section");
            sidebarItems.forEach((item) => {
              item.classList.remove("active");
            });
            const activeItem = document.querySelector(`[data-project="${sectionNum}"]`);
            if (activeItem) {
              activeItem.classList.add("active");
            }
          }
        });
      }, { threshold: 0.5 });

      sections.forEach((section) => observer.observe(section));

      // Sidebar navigation
      sidebarItems.forEach((item) => {
        item.addEventListener("click", () => {
          const sectionNum = item.getAttribute("data-project");
          const section = document.querySelector(`[data-section="${sectionNum}"]`);
          if (section) {
            section.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        });
      });
    });
  }
</script>
