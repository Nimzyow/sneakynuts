---
import "../styles/globals.css";
---

<head>
  <meta charset="UTF-8">
  <title>SneakyNuts</title>
  <meta name="description" content="SneakyNuts">
</head>

<div class="min-h-screen bg-black text-white flex flex-col items-center justify-center text-center">
  <h1 class="text-5xl md:text-7xl font-semibold tracking-[0.25em] uppercase">
    SneakyNuts
  </h1>

  <div class="logo-strip">
    <div class="logo-track">
      <span class="logo-link glow-purple">recommends</span>
      <span class="logo-link glow-green">Annai</span>
    </div>
  </div>
</div>

<style>
  .logo-strip {
    margin-top: 1.5rem;
    width: 100%;
    max-width: 600px;
    overflow: hidden;
  }

  .logo-track {
    display: inline-flex;
    gap: 3rem;
    justify-content: center;
    font-size: 0.9rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    animation: logo-marquee 10s linear infinite;
  }

  .logo-link {
    opacity: 0.25;
    transition:
      color 200ms ease,
      text-shadow 200ms ease,
      opacity 200ms ease,
      transform 200ms ease;
    cursor: default;
  }

  .logo-link:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .logo-link.glow-purple:hover {
    color: #a855f7;
    text-shadow: 0 0 18px rgba(168, 85, 247, 0.9);
  }

  .logo-link.glow-green:hover {
    color: #22c55e;
    text-shadow: 0 0 18px rgba(34, 197, 94, 0.9);
  }

  .logo-strip:hover .logo-track {
    animation-play-state: paused;
  }

  @keyframes logo-marquee {
    0% {
      transform: translateX(100%);
    }
    100% {
      transform: translateX(-100%);
    }
  }
</style>
