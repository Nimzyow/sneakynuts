---
import "../styles/globals.css";
---

<head>
  <meta charset="UTF-8">
  <title>SneakyNuts</title>
  <meta name="description" content="SneakyNuts">
  <style>
    html {
      scroll-snap-type: y mandatory;
      scroll-behavior: smooth;
    }
  </style>
</head>

<body>
<div id="boot-sequence" class="boot-sequence hidden">
  <div class="boot-line">SYSTEM INITIALIZING...</div>
  <div class="boot-line">LOADING PROJECT SUITE...</div>
  <div class="boot-line"></div>
  <div class="boot-bar">
    <div class="boot-bar-fill"></div>
  </div>
  <div class="boot-percentage">100%</div>
</div>

<div class="sidebar-nav">
  <div class="sidebar-item active" data-project="0">Home</div>
  <div class="sidebar-item" data-project="1">01</div>
  <div class="sidebar-item" data-project="2">02</div>
  <div class="sidebar-item" data-project="3">03</div>
  <div class="sidebar-item" data-project="4">04</div>
  <div class="sidebar-item" data-project="5">05</div>
  <div class="sidebar-item" data-project="6">WHOAMI</div>
</div>

<div class="snap-section main-section min-h-screen bg-black text-white flex flex-col items-center justify-center text-center" data-section="0">
  <h1 class="text-5xl md:text-7xl font-semibold tracking-[0.25em] uppercase anomaly-text">
    SneakyNuts
  </h1>
  
  <p class="mt-2 text-sm md:text-base tracking-[0.5em] opacity-60 text-gray-400">
    Architecting digital anomalies
  </p>

  <div class="logo-strip">
    <div class="logo-track">
      <span class="logo-link glow-purple">Recommends</span>
      <span class="logo-link glow-green">Annai</span>
      <span class="logo-link glow-blue">Nebula</span>
      <span class="logo-link glow-red">Cipher</span>
      <span class="logo-link glow-orange">Vault</span>
    </div>
  </div>

  <button id="begin-btn" class="begin-button">BEGIN</button>
</div>

<div class="snap-section project-section min-h-screen bg-black text-white flex flex-col items-center justify-center text-center" data-section="1">
  <div class="project-content project-content--fade">
    <h2 class="text-4xl md:text-6xl font-semibold tracking-[0.25em] uppercase mb-6 glow-purple">Recommends</h2>
    <div class="flex items-center justify-center gap-4 mb-6">
      <span class="text-xs tracking-widest opacity-60">PROJECT 01</span>
      <span class="w-1 h-1 bg-white rounded-full opacity-60"></span>
      <span class="text-xs tracking-widest opacity-60">LIVE</span>
    </div>
    <p class="text-base md:text-lg opacity-80 max-w-2xl mx-auto mb-6">
      Discover your next favorite meal. Unbiased, dish-level recommendations from real eaters. Never eat a disappointing meal again.
    </p>
    <a href="https://recommends.app/" target="_blank" rel="noopener noreferrer" class="inline-block mt-4 px-6 py-2 border border-white text-white hover:bg-white hover:text-black transition-all">Visit →</a>
  </div>
</div>

<div class="snap-section project-section min-h-screen bg-black text-white flex flex-col items-center justify-center text-center" data-section="2">
  <div class="project-content project-content--fade">
    <h2 class="text-4xl md:text-6xl font-semibold tracking-[0.25em] uppercase mb-6 glow-green">Annai</h2>
    <div class="flex items-center justify-center gap-4 mb-6">
      <span class="text-xs tracking-widest opacity-60">PROJECT 02</span>
      <span class="w-1 h-1 bg-white rounded-full opacity-60"></span>
      <span class="text-xs tracking-widest opacity-60">BUILDING</span>
    </div>
    <p class="text-base md:text-lg opacity-80 max-w-2xl mx-auto mb-6">
      Curiosity on your wrist.
    </p>
  </div>
</div>

<div class="snap-section project-section min-h-screen bg-black text-white flex flex-col items-center justify-center text-center" data-section="3">
  <div class="project-content project-content--fade">
    <h2 class="text-4xl md:text-6xl font-semibold tracking-[0.25em] uppercase mb-6 glow-blue">Nebula</h2>
    <div class="flex items-center justify-center gap-4 mb-6">
      <span class="text-xs tracking-widest opacity-60">PROJECT 03</span>
      <span class="w-1 h-1 bg-white rounded-full opacity-60"></span>
      <span class="text-xs tracking-widest opacity-60">LIVE</span>
    </div>
    <p class="text-base md:text-lg opacity-80 max-w-2xl mx-auto mb-6">
      Placeholder copy for Nebula. Describe the kind of world, experience, or product you imagine here.
    </p>
  </div>
</div>

<div class="snap-section project-section min-h-screen bg-black text-white flex flex-col items-center justify-center text-center" data-section="4">
  <div class="project-content project-content--fade">
    <h2 class="text-4xl md:text-6xl font-semibold tracking-[0.25em] uppercase mb-6 glow-red">Cipher</h2>
    <div class="flex items-center justify-center gap-4 mb-6">
      <span class="text-xs tracking-widest opacity-60">PROJECT 04</span>
      <span class="w-1 h-1 bg-white rounded-full opacity-60"></span>
      <span class="text-xs tracking-widest opacity-60">LIVE</span>
    </div>
    <p class="text-base md:text-lg opacity-80 max-w-2xl mx-auto mb-6">
      Placeholder copy for Cipher. Maybe this is something cryptic, secure, or mysterious—write that story later.
    </p>
  </div>
</div>

<div class="snap-section project-section min-h-screen bg-black text-white flex flex-col items-center justify-center text-center" data-section="5">
  <div class="project-content project-content--fade">
    <h2 class="text-4xl md:text-6xl font-semibold tracking-[0.25em] uppercase mb-6 glow-orange">Vault</h2>
    <div class="flex items-center justify-center gap-4 mb-6">
      <span class="text-xs tracking-widest opacity-60">PROJECT 05</span>
      <span class="w-1 h-1 bg-white rounded-full opacity-60"></span>
      <span class="text-xs tracking-widest opacity-60">LIVE</span>
    </div>
    <p class="text-base md:text-lg opacity-80 max-w-2xl mx-auto mb-6">
      Placeholder copy for Vault. A safe place for ideas, data, or something entirely different—fill in the details when you are ready.
    </p>
  </div>
</div>

<div class="snap-section project-section min-h-screen bg-black text-white flex flex-col items-center justify-center text-center" data-section="6">
  <div class="project-content project-content--fade">
    <div class="terminal-window">
      <div class="terminal-prompt">
        <span class="terminal-prefix">guest@sneakynuts:~$</span>
        <span id="terminal-command" class="typewriter-command"></span>
        <span class="terminal-cursor" id="terminal-cursor">_</span>
      </div>
      <div class="terminal-response" id="whoami-response" style="display: none; margin-top: 1rem;">
        <div>Two creators architecting digital anomalies. We don't build apps; we deploy deviations. One handles the logic (00001), the other the experience (00002).</div>
      </div>
      
      <div class="terminal-prompt" style="display: none; margin-top: 1rem;" id="uptime-prompt">
        <span class="terminal-prefix">guest@sneakynuts:~$</span>
        <span id="terminal-command-2" class="typewriter-command"></span>
        <span class="terminal-cursor">_</span>
      </div>
      <div class="terminal-response" id="uptime-response" style="display: none; margin-top: 1rem;">
        <div>OS: Sneakynuts_v1.0.4</div>
        <div>UPTIME: <span id="uptime-days">742</span> Days</div>
        <div>KERNEL: Anomalous_Build_09</div>
      </div>
    </div>
  </div>
</div>
</body>

<style>
  .sidebar-nav {
    position: fixed;
    left: 2rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    z-index: 100;
  }

  .sidebar-item {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #555555;
    cursor: pointer;
    transition: color 200ms ease;
  }

  .sidebar-item:hover {
    color: #a1a1aa;
  }

  .sidebar-item.active {
    color: #ffffff;
    position: relative;
  }

  .sidebar-item.active::after {
    content: "█";
    display: inline-block;
    margin-left: 0.3rem;
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%, 49% {
      opacity: 1;
    }
    50%, 100% {
      opacity: 0;
    }
  }

  .project-section {
    opacity: 1;
    transition: opacity 300ms ease;
  }

  .project-content--fade {
    animation: fadeIn 500ms ease forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .snap-section {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .main-section {
    min-height: 100vh;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #ffffff;
  }

  .anomaly-text {
    position: relative;
    cursor: pointer;
    color: #ffffff;
    letter-spacing: 2px;
    transition: all 600ms ease;
  }

  .anomaly-text.boot-up {
    animation: headerBootUp 600ms ease forwards;
  }

  @keyframes headerBootUp {
    0% {
      font-size: inherit;
      opacity: 1;
      transform: translateY(0);
    }
    100% {
      font-size: 2rem;
      opacity: 0.7;
      transform: translateY(-2rem);
    }
  }

  .anomaly-text:hover {
    animation: glitch-bw 3s infinite;
  }

  @keyframes glitch-bw {
    0% { text-shadow: 1.5px 0px 0px rgba(255,255,255,0.6), -1.5px 0px 0px rgba(200,200,200,0.4); transform: translate(0); }
    20% { text-shadow: -2.5px 0px 0px rgba(255,255,255,0.5), 2.5px 0px 0px rgba(150,150,150,0.5); transform: translate(1.5px, -1px); }
    40% { text-shadow: 2.5px 0px 1px rgba(180,180,180,0.5), -2.5px 0px 1px rgba(255,255,255,0.4); transform: translate(-1.5px, 1px); }
    60% { text-shadow: 2px 0.5px 0px rgba(200,200,200,0.45), -2px -0.5px 0px rgba(255,255,255,0.5); transform: translate(1px, -0.5px); }
    100% { text-shadow: 1.5px 0px 0px rgba(255,255,255,0.6), -1.5px 0px 0px rgba(200,200,200,0.4); transform: translate(0); }
  }

  .logo-strip {
    margin-top: 1.5rem;
    width: 100%;
    max-width: 600px;
    overflow: hidden;
  }

  .logo-track {
    display: inline-flex;
    gap: 3rem;
    justify-content: center;
    font-size: 0.9rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    animation: logo-marquee 10s linear infinite;
  }

  .logo-link {
    opacity: 0.25;
    transition:
      color 200ms ease,
      text-shadow 200ms ease,
      opacity 200ms ease,
      transform 200ms ease;
    cursor: pointer;
  }

  .logo-link:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .logo-link.glow-purple:hover {
    color: #a855f7;
    text-shadow: 0 0 18px rgba(168, 85, 247, 0.9);
  }

  h2.glow-purple {
    color: #a855f7;
    text-shadow: 0 0 18px rgba(168, 85, 247, 0.9);
  }

  h2.glow-green {
    color: #22c55e;
    text-shadow: 0 0 18px rgba(34, 197, 94, 0.9);
  }

  h2.glow-blue {
    color: rgb(34, 69, 197);
    text-shadow: 0 0 18px rgba(34, 80, 197, 0.9);
  }

  h2.glow-red {
    color: rgb(197, 34, 45);
    text-shadow: 0 0 18px rgba(197, 34, 53, 0.9);
  }

  h2.glow-orange {
    color: rgb(233, 131, 23);
    text-shadow: 0 0 18px rgba(197, 86, 34, 0.9);
  }

  .logo-link.glow-green:hover {
    color: #22c55e;
    text-shadow: 0 0 18px rgba(34, 197, 94, 0.9);
  }

  .logo-link.glow-blue:hover {
    color:rgb(34, 69, 197);
    text-shadow: 0 0 18px rgba(34, 80, 197, 0.9);
  }

  .logo-link.glow-red:hover {
    color:rgb(197, 34, 45);
    text-shadow: 0 0 18px rgba(197, 34, 53, 0.9);
  }

    .logo-link.glow-orange:hover {
    color:rgb(233, 131, 23);
    text-shadow: 0 0 18px rgba(197, 86, 34, 0.9);
  }

  .logo-strip:hover .logo-track {
    animation-play-state: paused;
  }

  .boot-sequence {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    font-family: monospace;
    color: #00ff00;
    padding: 2rem;
    text-align: center;
  }

  .boot-sequence.hidden {
    display: none;
  }

  .boot-line {
    margin: 0.5rem 0;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    animation: fadeInLine 200ms ease forwards;
    opacity: 0;
  }

  .boot-line:nth-child(1) { animation-delay: 0ms; }
  .boot-line:nth-child(2) { animation-delay: 150ms; }
  .boot-line:nth-child(3) { animation-delay: 300ms; }
  .boot-line:nth-child(4) { animation-delay: 450ms; }
  .boot-line:nth-child(5) { animation-delay: 600ms; }

  @keyframes fadeInLine {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .boot-bar {
    width: 300px;
    height: 1rem;
    border: 1px solid #00ff00;
    margin: 1rem auto;
    position: relative;
    overflow: hidden;
  }

  .boot-bar-fill {
    height: 100%;
    background-color: #00ff00;
    width: 0%;
    animation: fillBar 800ms ease forwards;
  }

  @keyframes fillBar {
    0% { width: 0%; }
    100% { width: 100%; }
  }

  .boot-percentage {
    font-size: 0.8rem;
    margin-top: 0.5rem;
    animation: fadeInLine 200ms ease forwards 900ms;
    opacity: 0;
  }

  .terminal-window {
    font-family: monospace;
    color: #00ff00;
    background-color: rgba(0, 0, 0, 0.5);
    border: 1px solid #00ff00;
    padding: 2rem;
    width: 600px;
    text-align: left;
    margin: 0 auto;
  }

  .terminal-line {
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }

  .terminal-prompt {
    letter-spacing: 0.05em;
    cursor: text;
    user-select: none;
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
  }

  .terminal-prefix {
    margin-right: 0.3rem;
    flex-shrink: 0;
  }

  #terminal-command {
    font-weight: bold;
  }

  .typewriter-command {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    font-size: inherit;
    flex-shrink: 0;
  }

  .typewriter-command.typing {
    animation: typeCommand 1.2s steps(6, end) forwards;
  }

  @keyframes typeCommand {
    0% {
      width: 0;
    }
    100% {
      width: 6.5ch;
    }
  }

  .terminal-cursor {
    display: inline-block;
    margin-left: 0.2rem;
    animation: cursorBlink 1s infinite;
    flex-shrink: 0;
  }

  @keyframes cursorBlink {
    0%, 49% {
      opacity: 1;
    }
    50%, 100% {
      opacity: 0;
    }
  }

  .terminal-response {
    word-wrap: break-word;
    line-height: 1.6;
    animation: fadeInLine 500ms ease forwards;
  }

  .typewriter {
    overflow: hidden;
    white-space: pre-wrap;
    border-right: 2px solid #00ff00;
    animation: none;
  }

  .typewriter.active {
    animation: typewriter 2s steps(75, end) forwards;
  }

  @keyframes typewriter {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }

  .begin-button {
    margin-top: 1.5rem;
    padding: 0.75rem 2rem;
    background-color: transparent;
    border: 1px solid #555555;
    color: #a1a1aa;
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .begin-button:hover {
    color: #ffffff;
    border-color: #ffffff;
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.2);
  }

  .begin-button.hidden {
    display: none;
  }

  @keyframes logo-marquee {
    0% {
      transform: translateX(100%);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  .logo-detail {
    margin-top: 2.5rem;
    width: fit-content;
    padding: 0 1.5rem;
    margin-left: auto;
    margin-right: auto;
    max-height: 0;
    opacity: 0;
    overflow: visible;
    transform: translateY(8px);
    border-top: 1px solid #27272a;
    animation: pulse-border 3s ease-in-out infinite;
    transition:
      max-height 300ms ease,
      opacity 250ms ease,
      transform 250ms ease;
    min-width: 200px;
  }

  @keyframes pulse-border {
    0% {
      border-color: #27272a;
    }
    50% {
      border-color: #555555;
    }
    100% {
      border-color: #27272a;
    }
  }

  .logo-detail--open {
    max-height: 400px;
    opacity: 1;
    transform: translateY(0);
  }

  .logo-detail__title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 1.5rem 0 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
  }

  .logo-detail__body {
    font-size: 0.9rem;
    color: #a1a1aa;
    margin-bottom: 1.75rem;
    line-height: 1.7;
  }
</style>

<script>
  if (typeof window !== "undefined") {
    window.addEventListener("DOMContentLoaded", () => {
      const beginBtn = document.getElementById("begin-btn");
      const sidebarItems = document.querySelectorAll(".sidebar-item");

      if (beginBtn) {
        beginBtn.addEventListener("click", () => {
          beginBtn.classList.add("hidden");
          
          // Show boot sequence
          const bootSequence = document.getElementById("boot-sequence");
          if (bootSequence) {
            bootSequence.classList.remove("hidden");
          }
          
          // Play boot-up animation on header
          const header = document.querySelector(".anomaly-text");
          if (header) {
            header.classList.add("boot-up");
          }
          
          // Light up the 01 sidebar item
          sidebarItems.forEach((item) => {
            item.classList.remove("active");
          });
          const project01 = document.querySelector('[data-project="1"]');
          if (project01) {
            project01.classList.add("active");
          }
          
          // Hide boot sequence and scroll to first project after 1.2 seconds
          setTimeout(() => {
            if (bootSequence) {
              bootSequence.classList.add("hidden");
            }
            const firstProject = document.querySelector('[data-section="1"]');
            if (firstProject) {
              firstProject.scrollIntoView({ behavior: "smooth", block: "start" });
            }
          }, 1200);
        });
      }

      // Calculate uptime days from 12/30/2024
      function calculateUptimeDays() {
        const startDate = new Date("2024-12-30");
        const today = new Date();
        const timeDiff = today - startDate;
        const daysDiff = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
        return daysDiff;
      }

      const uptimeDaysSpan = document.getElementById("uptime-days");
      if (uptimeDaysSpan) {
        uptimeDaysSpan.textContent = calculateUptimeDays();
      }

      // Update sidebar on scroll
      const sections = document.querySelectorAll(".snap-section");
      const header = document.querySelector(".anomaly-text");
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const sectionNum = entry.target.getAttribute("data-section");
            sidebarItems.forEach((item) => {
              item.classList.remove("active");
            });
            const activeItem = document.querySelector(`[data-project="${sectionNum}"]`);
            if (activeItem) {
              activeItem.classList.add("active");
            }
            
            // Reset header size when returning to home
            if (sectionNum === "0" && header) {
              header.classList.remove("boot-up");
            }
            
            // Trigger interactive whoami for section 6
            if (sectionNum === "6") {
              const terminalCommand = document.getElementById("terminal-command");
              const whoamiResponse = document.getElementById("whoami-response");
              const terminalPrompt = document.querySelector(".terminal-prompt");
              
              // Auto-start typing when section comes into view
              if (terminalCommand && !terminalCommand.dataset.started) {
                terminalCommand.dataset.started = "true";
                terminalCommand.textContent = "whoami";
                terminalCommand.classList.add("typing");
              }
              
              // Setup enter key listener if not already done
              if (terminalPrompt && !terminalPrompt.dataset.interactive) {
                terminalPrompt.dataset.interactive = "true";
                
                const terminalCommand2 = document.getElementById("terminal-command-2");
                const uptimePrompt = document.getElementById("uptime-prompt");
                const uptimeResponse = document.getElementById("uptime-response");
                
                document.addEventListener("keydown", function handleTerminalEnter(e) {
                  if (e.key === "Enter") {
                    e.preventDefault();
                    
                    // First Enter: show whoami response and start uptime
                    if (whoamiResponse && whoamiResponse.style.display === "none") {
                      if (terminalCommand) {
                        terminalCommand.classList.remove("typing");
                        whoamiResponse.style.display = "block";
                      }
                      
                      // Start typing uptime command
                      setTimeout(() => {
                        if (uptimePrompt && terminalCommand2) {
                          uptimePrompt.style.display = "flex";
                          terminalCommand2.textContent = "uptime";
                          terminalCommand2.classList.add("typing");
                        }
                      }, 500);
                    }
                    // Second Enter: show uptime response
                    else if (uptimeResponse && uptimeResponse.style.display === "none") {
                      if (terminalCommand2) {
                        terminalCommand2.classList.remove("typing");
                        uptimeResponse.style.display = "block";
                      }
                      document.removeEventListener("keydown", handleTerminalEnter);
                    }
                  }
                });
              }
            }
          }
        });
      }, { threshold: 0.5 });

      sections.forEach((section) => observer.observe(section));

      // Sidebar navigation
      sidebarItems.forEach((item) => {
        item.addEventListener("click", () => {
          const sectionNum = item.getAttribute("data-project");
          const section = document.querySelector(`[data-section="${sectionNum}"]`);
          if (section) {
            section.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        });
      });
    });
  }
</script>
